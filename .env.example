# PostgreSQL connection string used by Prisma and pg-boss.
DATABASE_URL=""
# Required. Use 16+ characters and at least three of: lowercase, uppercase, digits, symbols.
# Startup rejects missing, placeholder, and common/clearly weak values. Generate and store this
# yourself; Auditly never generates or prints authentication secrets.
AUDITLY_PASSWORD=""

# Local development only: explicit process-wide policy allowing fast-tier and browser traffic
# to localhost/private-network hosts. Never enable this in a shared or internet-facing deployment.
# AUDITLY_ALLOW_PRIVATE_NETWORK="false"

# Optional: use an installed Chrome/Edge binary instead of Playwright's downloaded Chromium.
# Useful on machines where the Playwright browser download is blocked by local TLS/certificate policy.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""

# Optional: memory cap for the isolated Lighthouse child process.
# Lower values fail single oversized performance audits without killing the worker.
# LIGHTHOUSE_CHILD_HEAP_MB="1536"

# Optional scan-pipeline tuning (sensible defaults if unset).
# Global crawl concurrency across all sites; per-host politeness is enforced separately.
# AUDITLY_CRAWL_CONCURRENCY="30"
# Scans are globally serialized: each request is saved and the worker runs them FIFO, one at a time.
# Per-worker, per-host in-flight request ceiling. With multiple crawl-worker processes, divide
# the desired origin-wide ceiling across them; DB-backed site/global limits remain exact.
# AUDITLY_HOST_CONCURRENCY="5"
# Cap on a fetched page body, in megabytes (larger bodies are truncated, not failed).
# AUDITLY_MAX_BODY_MB="5"
# Watchdog failure limit: a scan is marked FAILED only when it is older than this and has also
# made no progress for this entire duration. Healthy large scans are allowed to run longer.
# AUDITLY_MAX_SCAN_MINUTES="240"

# Explicit independent database budgets. A connection_limit already present in DATABASE_URL
# overrides the app/worker values. Keep the sum across app replicas, worker processes, queue
# pools, migrations, and admin tools below PostgreSQL max_connections with headroom.
# AUDITLY_DB_APP_CONNECTION_LIMIT="8"
# AUDITLY_DB_WORKER_CONNECTION_LIMIT="12"
# AUDITLY_DB_QUEUE_CONNECTION_LIMIT="5"
# AUDITLY_DB_POOL_TIMEOUT_SECONDS="10"

# Optional: libuv threadpool size (default 4). dns.lookup() and some fs ops share this pool;
# a crawler doing many concurrent external-link DNS lookups can exhaust the default under load.
# Must be set before the process starts (Node reads it once at startup).
# UV_THREADPOOL_SIZE="16"
