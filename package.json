{
  "name": "auditly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "security:preflight": "node scripts/security-preflight.mjs",
    "dev": "npm run security:preflight && next dev -H 127.0.0.1 -p 3210",
    "dev:all": "concurrently -n db,worker,web -c blue,magenta,green \"npm run db:dev\" \"npm run worker\" \"npm run dev\"",
    "build": "next build",
    "start": "npm run security:preflight && next start -H 127.0.0.1 -p 3210",
    "worker": "node --env-file-if-exists=.env --import tsx src/workers/boot.ts",
    "worker:watch": "tsx watch --env-file=.env src/workers/boot.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "test:scan-state": "tsx --env-file=.env --test src/lib/crawler/rateLimit.test.ts src/lib/scan/scheduleOccurrence.test.ts src/workers/jobs/pipeline.integration.test.ts",
    "test:security": "tsx --test src/lib/security.test.ts src/lib/network/egress.test.ts",
    "typecheck": "tsc --noEmit",
    "rescore:history": "tsx --env-file=.env scripts/rescore-history.ts",
    "seed:scale": "tsx --env-file=.env scripts/seed-scale.ts",
    "test:scoring": "tsx --env-file=.env --test src/lib/scoringPolicy.test.ts",
    "test:control-plane": "tsx --env-file=.env --test src/lib/scan/cron.test.ts src/lib/scan/scheduleOccurrence.test.ts src/lib/controlLease.test.ts src/workers/controlPlane.test.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "cheerio": "^1.0.0",
    "cron-parser": "^5.4.0",
    "dictionary-en": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "lighthouse": "^13.6.0",
    "next": "^15.5.29",
    "nspell": "^2.1.5",
    "pg-boss": "^10.1.5",
    "playwright": "^1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.1",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "prisma": "^6.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.5",
      "postcss": "8.5.33"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "tailwindcss": {
      "postcss-selector-parser": "6.1.5"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.22"
    }
  }
}
